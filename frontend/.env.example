VITE_API_BASE_URL=http://localhost:8000
# REGOS SSO button (Login with Regos / Regos ID on /login)
# Set to false to hide SSO even if client id and redirect URI are set.
# VITE_REGOS_SSO_ENABLED=true
# Must match the exact redirect URI registered for the OAuth client in REGOS
# (including host + port). App is often served on :8080 via nginx/dev.cmd.
# VITE_REGOS_SSO_CLIENT_ID=your_client_id
# VITE_REGOS_SSO_REDIRECT_URI=http://localhost:8080/oauth/redirect.html
