# Local/dev default (SQLite). Production should use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://regos:PASSWORD@127.0.0.1:5432/regos
DATABASE_URL=sqlite+aiosqlite:///./data/regos.db
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_NAME=Regos Wholesale
RESEND_API_KEY=
RESEND_EMAIL_FROM=yourdomain.com
REGOS_OAUTH_TOKEN_URL=https://auth.regos.uz/oauth/token
REGOS_CLIENT_ID=
REGOS_CLIENT_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
REGOS_WEBHOOK_URL=
# Public base URL for shared document links (/public/templates/{token})
PUBLIC_APP_BASE_URL=
RECEIPT_SHARE_TTL_HOURS=24
RECEIPT_SHARE_MAX_BYTES=2097152
RECEIPT_SHARE_STORAGE_DIR=./data/receipt-shares
REGISTRATION_TRIAL_DAYS=7
SUBSCRIPTION_DAYS_PER_MONTH=30
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Daily CBU exchange-rate fetch time in Asia/Tashkent (HH:MM, 24-hour)
CBU_EXCHANGE_RATE_FETCH_TIME=10:00
